# === Base de données ===
DB_NAME=omardb
DB_USER=omar
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === Redis ===
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# === JWT ===
SECRET_KEY=CHANGE_ME_256BIT_RANDOM_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === Compte d'accès ===
ADMIN_USERNAME=omar
ADMIN_PASSWORD=CHANGE_ME_PASSWORD

# === Application ===
# Port exposé sur l'hôte (80 pour prod, 8080 pour dev local)
APP_PORT=80
DEBUG=false

# Origines autorisées pour CORS (URL complète du serveur)
# Pour plusieurs origines : http://192.168.1.100,https://omar.example.com
ALLOWED_ORIGINS=http://localhost

# === Note HTTPS / Caméra ===
# Le scanner code-barre (BarcodeDetector) ne fonctionne QUE via :
#   - https:// (HTTPS avec certificat valide ou auto-signé)
#   - http://localhost (dev local uniquement)
# Sur une IP locale (http://192.168.x.x), la caméra est bloquée par le navigateur.
# Pour activer HTTPS, voir les commentaires dans nginx/nginx.conf.
